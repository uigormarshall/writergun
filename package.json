{
  "name": "writergun",
  "version": "0.1.0",
  "description": "CLI para automatizar criação de posts em Markdown usando Ollama (modelos locais).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "writergun": "./bin/writergun.js"
  },
  "scripts": {
    "dev": "tsx src/bin.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "dotenv": "^17.2.0",
    "ollama": "^0.6.3",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}

