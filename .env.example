## Writergun
WRITERGUN_ROOT=targets
# Idioma do draft/final (default: pt-BR)
# WRITERGUN_LOCALE=pt-BR

## Ollama
OLLAMA_HOST=http://127.0.0.1:11434
# Necessário para webSearch/webFetch (quando habilitar WRITERGUN_WEB=true)
# IMPORTANTE: não commite sua chave. Use o arquivo `.env` (ignorado pelo git).
OLLAMA_API_KEY=

## Defaults do comando `shot`
WRITERGUN_MODEL=qwen2.5:7b
WRITERGUN_NUM_CTX=4096
WRITERGUN_TIMEOUT_MS=180000

## Web (contexto automático)
WRITERGUN_WEB=true
WRITERGUN_WEB_MAX_RESULTS=5
WRITERGUN_WEB_TIMEOUT_MS=30000

## Estilo do texto (blog)
WRITERGUN_MIN_WORDS=1200
WRITERGUN_PARAGRAPH_SENTENCES=3–6
WRITERGUN_CITATIONS=true

## Logs (NDJSON local)
# WRITERGUN_LOG=1
# WRITERGUN_LOG_DIR=.writergun/logs
# WRITERGUN_LOG_LEVEL=info

## UI
# WRITERGUN_BANNER=1

